{
  "name": "agent-reliability-gateway",
  "private": true,
  "version": "0.0.0",
  "description": "MCP gateway that makes agent calls to unreliable HTTP APIs safe: idempotency, retries, reconcile, rate limits, budgets, audit.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "setup": "pnpm install --frozen-lockfile && node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy:aws": "pnpm --filter @arg/infra run deploy",
    "destroy:aws": "pnpm --filter @arg/infra run destroy",
    "mock": "pnpm --filter @arg/providers-mock run start",
    "smoke:aws": "bash scripts/smoke-aws.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
