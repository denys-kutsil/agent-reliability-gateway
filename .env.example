# Every environment variable used by the project is documented here.
# Everything must start without a .env file: all values below are the defaults.
# Copy to .env only to override them. Never put real secrets in this file.

# --- Local infrastructure (docker-compose.yml, scripts/) ---
POSTGRES_USER=arg
POSTGRES_PASSWORD=arg
POSTGRES_DB=arg
POSTGRES_PORT=5432

DYNAMODB_PORT=8000
# Endpoint used by local tools; DynamoDB Local accepts any credentials.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=us-east-1
